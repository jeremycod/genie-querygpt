        {
          "name": "profile",
          "data_type": "varchar",
          "nullable": false,
          "description": "Tenant/profile",
          "pii": false
        },
        {
          "name": "version",
          "data_type": "bigserial",
          "nullable": false,
          "description": "Campaign version snapshot",
          "pii": false
        },
        {
          "name": "deleted",
          "data_type": "boolean",
          "nullable": true,
          "description": "Soft delete flag (if present)",
          "pii": false
        }
      ],
      "json_paths": [],
      "common_filters": [],
      "tags": [
